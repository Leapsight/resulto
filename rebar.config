{minimum_otp_vsn, "R26"}.
{erl_opts, [
    debug_info
]}.

{project_plugins, [
    rebar3_proper,
    rebar3_ex_doc,
    rebar3_hex
]}.


%% =============================================================================
%% TEST / QUALITY
%% =============================================================================


{cover_enabled, true}.
{cover_opts, [verbose]}.
{cover_export_enabled, true}.

{covertool, [
    {coverdata_files, ["ct.coverdata"]}
]}.

{eunit_opts, [
    verbose
]}.

%% =============================================================================
%% DOCS
%% =============================================================================


{hex, [
    {doc, #{provider => ex_doc}}
]}.


{ex_doc, [
    {source_url, <<"https://github.com/leapsight/resulto">>},
    {extras, [
        <<"README.md">>,
        <<"LICENSE.md">>
    ]},
    {main, <<"README.md">>},
    {api_reference, true}
]}.
